# Safe local defaults for Ollama. Replace these only in your ignored .env file.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_TEXT_MODEL=qwen2.5:7b-instruct
LLM_VISION_MODEL=qwen2.5vl:7b
LLM_TIMEOUT=30.0
LLM_MOCK=false

# Geospatial thresholds (meters) and clustering minimum complaint count.
GEOFENCE_METERS=50
CLUSTER_EPS_METERS=150
CLUSTER_MIN_SAMPLES=3
